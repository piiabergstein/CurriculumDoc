# Render annab automaatselt
DATABASE_URL=postgresql://user:pass@host:5432/db
PORT=3000
# Pikk juhuslik saladus (nt openssl rand -hex 32) – sessioonide ja allalaadimislinkide allkirjastamiseks
SESSION_SECRET=
# Rakenduse avalik aadress, nt https://meliva-profiilid.onrender.com
APP_URL=
# production | test  (test = lubatud märgistatud mock-teenused, ainult arenduseks)
APP_MODE=production
# Tekst, tõlge, CV/OCR
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tausta eemaldus (Replicate)
REPLICATE_API_TOKEN=
REPLICATE_BG_MODEL=851-labs/background-remover
# Tööriietuse muutmine (Gemini image)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
